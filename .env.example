# ==============================================================================
# StayNest Environment Variables Template
# ==============================================================================

# --- Backend Configurations ---
# Database connection URI. Defaults to a local SQLite database 'airbnb.db' at the root.
DATABASE_URL=sqlite:///./airbnb.db

# JWT encryption secret key. Change this to a secure random string in production.
JWT_SECRET=change-me

# Configurable Frontend domain URL used for CORS authorization checks
FRONTEND_URL=http://localhost:3000

# --- Frontend Configurations ---
# Base API URL used by Next.js clients to communicate with the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
